{
  "name": "sponspay",
  "version": "1.0.0-beta.132",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl --configuration local-local",
    "start:dev": "ng serve --ssl --configuration local-dev",
    "build": "ng build",
    "watch": "ng build --watch --configuration local-dev",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --code-coverage --watch=false",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessOptimized --exclude='**/integration-tests/**/*.spec.ts'",
    "test:fast": "ng test --watch=false --browsers=ChromeHeadlessOptimized",
    "test:ultra": "PERFORMANCE_MODE=true ng test --watch=false --browsers=ChromeHeadlessOptimized",
    "test:single": "ng test --watch=false --browsers=ChromeHeadless",
    "test:performance": "npm run test:ultra && npm run test:timing",
    "test:parallel": "node scripts/parallel-test.js --parallel",
    "test:timing": "node scripts/test-performance.js",
    "test:debug": "DEBUG_TESTS=true ng test --source-map=true",
    "test:verbose": "VERBOSE_TESTS=true ng test",
    "test:verbose:single": "VERBOSE_TESTS=true ng test --watch=false --browsers=ChromeHeadless",
    "test:integration": "ng test --include='**/integration-tests/**/*.spec.ts' --watch=false --browsers=ChromeHeadlessOptimized",
    "test:coverage-check": "npm run test:coverage && node scripts/check-coverage.js",
    "coverage:serve": "npx http-server coverage/sponspay -p 8080 -o",
    "locale": "ng extract-i18n --output-path src/locale --format=json",
    "analyze": "esbuild-visualizer --metadata ./dist/sponspay/stats.json",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:run:headless": "cypress run --headless",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:firefox": "cypress run --browser firefox",
    "cypress:run:edge": "cypress run --browser edge",
    "cypress:test": "cypress run --watch=false",
    "cypress:test:ci": "cypress run --headless --browser chrome --record false",
    "cypress:test:mobile": "cypress run --config viewportWidth=375,viewportHeight=667",
    "cypress:test:tablet": "cypress run --config viewportWidth=768,viewportHeight=1024",
    "cypress:test:desktop": "cypress run --config viewportWidth=1280,viewportHeight=720",
    "cypress:test:responsive": "npm run cypress:test:mobile && npm run cypress:test:tablet && npm run cypress:test:desktop",
    "cypress:test:landing": "cypress run --spec 'cypress/e2e/landing-page.cy.ts'",
    "cypress:test:onboarding": "cypress run --spec 'cypress/e2e/onboarding/**/*.cy.ts'",
    "cypress:test:performance": "cypress run --spec 'cypress/e2e/performance-accessibility.cy.ts'",
    "cypress:verify": "cypress verify",
    "quality-gate": "npm run test:coverage-check && npm run cypress:test:ci",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:check": "ng lint --max-warnings=0",
    "lint:ci": "ng lint --max-warnings=0 --format=json",
    "commit": "git-cz",
    "commitlint": "commitlint --edit",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/platform-browser-dynamic": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ng-select/ng-select": "^21.8.0",
    "@popperjs/core": "^2.11.8",
    "awesome-phonenumber": "^7.5.0",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.0",
    "intl-tel-input": "^27.0.0",
    "ng2-charts": "^10.0.0",
    "ngx-toastr": "^20.0.5",
    "qr-code-styling": "^1.9.2",
    "rxjs": "^7.8.0",
    "socket.io-client": "^4.8.1",
    "svg-country-flags": "^1.2.10",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "overrides": {
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@angular/localize": "^21.2.8",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@cypress/schematic": "^5.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^12.0.0",
    "@types/bootstrap": "^5.2.10",
    "@types/intl-tel-input": "^18.1.4",
    "@types/jasmine": "~6.0.0",
    "angular-eslint": "21.3.1",
    "cypress": "^15.0.0",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.29.0",
    "jasmine-core": "~6.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "karma-spec-reporter": "^0.0.36",
    "semantic-release": "^25.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "8.58.2"
  }
}
