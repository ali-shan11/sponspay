# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_SYNC=false

# Application Configuration
NODE_ENV=development
NODE_PORT=3000

# Authentication & Security
SERVICE_ACCOUNT=your_service_account
SERVICE_ACCOUNT_PRIVATE_KEY=your_private_key
SERVICE_ACCOUNT_USER=your_service_user
API_KEY_ALLOWED_DOMAINS=localhost,yourdomain.com

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourdomain.com
CONTACT_US_EMAIL=contact@yourdomain.com
MANAGEMENT_EMAIL=sponspay-management@sponspay.com

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account
FIREBASE_CHECK_REVOKED=false

# External APIs
TIMEZONE_API_URL=your_timezone_api_url
PHOTOS_BUCKET=your_photos_bucket

# Zoho CRM Configuration
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REDIRECT_URI=http://localhost:3000/oauth/callback
ZOHO_REFRESH_TOKEN=your_refresh_token_here_after_setup
ZOHO_ENVIRONMENT=production

# Telegram Adapter Service
TELEGRAM_SERVICE_URL=http://telegram-service:3000
INTERNAL_API_KEY=your_internal_api_key

# PawaPay Configuration
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io/v2
PAWAPAY_API_TOKEN=your_pawapay_api_token
PAWAPAY_CALLBACK_AUTHORITY=yourdomain.com
# SECURITY: Only 'true' for local dev/testing. MUST be 'false' in production.
PAWAPAY_SKIP_SIGNATURE_VERIFICATION=false

# Security Configuration
ANONYMIZATION_SALT=your_secure_random_salt_here

# Verification Configuration
VERIFICATION_CODE_VALIDITY_MS=300000
VERIFICATION_RESEND_COOLDOWN_MS=20000
VERIFICATION_MAX_ATTEMPTS=3

# ExchangeRate API Configuration
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# Redis Configuration (for WebSocket multi-pod scaling)
REDIS_URL=redis://localhost:6379

# Infobip Configuration
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_SENDER=SponsPay
